# Standalone backend local development uses SQLite by default.
DATABASE_URL=sqlite:///./hirepilot.db
# Docker Compose reads POSTGRES_* from the repository-root .env file.
POSTGRES_USER=hirepilot_dev
POSTGRES_PASSWORD=hirepilot_dev_password_change_me
POSTGRES_DB=hirepilot_dev
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
UPLOAD_DIR=uploads
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
LOG_LEVEL=INFO
DEBUG=false
